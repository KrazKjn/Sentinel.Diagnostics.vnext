{
  "AutoLogger": {
    "MinimumLevel": {
      "Level": "Debug",
      "Verbosity": 4
    },
    "IndentLevel": 4,
    "WarningThresholdMs": 250,

    "Loggers": [
      "Console",
      "Debug",
      "File:logs/sentinel.log",
      "Json:logs/sentinel.json"
    ],

    "NamespaceLevels": {
      "SampleCode.TestConsoleApp.Mathematics": {
        "Level": "Debug"
      }
    },

    "ClassLevels": {
      "SampleCode.TestConsoleApp.Mathematics.DivideService": {
        "Level": "Warning"
      }
    },

    "MethodLevels": {
      "Divide": {
        "Level": "Debug",
        "Verbosity": 4
      }
    }
  }
}
