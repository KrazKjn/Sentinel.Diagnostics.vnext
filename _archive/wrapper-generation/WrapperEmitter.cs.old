using Microsoft.CodeAnalysis;
using Sentinel.Diagnostics.Generator.Compatibility;
using Sentinel.Diagnostics.Generator.Diagnostics;
using Sentinel.Diagnostics.Generator.Metadata;
using System;
using System.Text;

namespace Sentinel.Diagnostics.Generator.Emitters;

/// <summary>
/// Generates AutoLog wrapper members inside the original containing type.
///
/// Wrapper members are emitted as partial type declarations rather than
/// standalone wrapper classes. This allows generated instance wrappers
/// to execute in the context of the original type and access instance
/// members naturally.
/// </summary>
internal static class WrapperEmitter
{
    /// <summary>
    /// Emits the generated wrapper member for a method.
    /// </summary>
    /// <param name="context">
    /// The source production context.
    /// </param>
    /// <param name="metadata">
    /// Finalized metadata describing the method.
    /// </param>
    public static void Emit(
        SourceProductionContext context,
        SentinelMethodGenerationMetadata metadata)
    {
        //Guard.NotNull(context, nameof(context));
        Guard.NotNull(metadata, nameof(metadata));

        if (!metadata.IsDeclaringTypePartial)
        {
            return;
        }

        if (!IsSupportedAccessibility(metadata))
        {
            return;
        }

        if (!ValidateContainingTypes(
            context,
            metadata))
        {
            return;
        }

        string source =
            GenerateWrapperSource(metadata);

        string hintName =
            CreateHintName(metadata);

        context.AddSource(
            hintName,
            source);
    }

    /// <summary>
    /// Generates the complete source file containing the partial
    /// containing type and generated wrapper method.
    /// </summary>
    private static string GenerateWrapperSource(
        SentinelMethodGenerationMetadata metadata)
    {
        var source = new StringBuilder();

        source.AppendLine("// <auto-generated />");
        source.AppendLine("#nullable enable");
        source.AppendLine();

        if (!string.IsNullOrWhiteSpace(
                metadata.DeclaringNamespace))
        {
            source.Append("namespace ");
            source.Append(metadata.DeclaringNamespace);
            source.AppendLine(";");
            source.AppendLine();
        }

        source.AppendLine(
            $"partial class {metadata.DeclaringTypeName}");

        source.AppendLine("{");

        GenerateWrapperMethod(
            source,
            metadata);

        source.AppendLine("}");

        return source.ToString();
    }

    /// <summary>
    /// Generates the wrapper method for a single AutoLog-decorated
    /// method.
    /// </summary>
    private static void GenerateWrapperMethod(
        StringBuilder source,
        SentinelMethodGenerationMetadata metadata)
    {
        source.AppendLine(
            "    /// <summary>");

        source.AppendLine(
            "    /// Generated Sentinel Diagnostics AutoLog wrapper.");

        source.AppendLine(
            "    /// </summary>");

        source.Append("    ");

        if (metadata.IsStatic)
        {
            source.Append("static ");
        }

        if (metadata.IsAsync)
        {
            source.Append("async ");
        }

        source.Append(metadata.ReturnType);
        source.Append(' ');
        source.Append(metadata.MethodName);
        source.AppendLine("_AutoLog(");

        GenerateMethodParameters(
            source,
            metadata);

        source.AppendLine("    )");
        source.AppendLine("    {");

        GenerateMethodBody(
            source,
            metadata);

        source.AppendLine("    }");
    }

    /// <summary>
    /// Generates the wrapper parameter declarations while preserving
    /// ref, out, in, and params modifiers.
    /// </summary>
    private static void GenerateMethodParameters(
        StringBuilder source,
        SentinelMethodGenerationMetadata metadata)
    {
        for (int index = 0;
             index < metadata.Parameters.Length;
             index++)
        {
            SentinelParameterGenerationMetadata parameter =
                metadata.Parameters[index];

            source.Append("        ");

            source.Append(
                BuildParameterDeclaration(parameter));

            if (index < metadata.Parameters.Length - 1)
            {
                source.Append(',');
            }

            source.AppendLine();
        }
    }

    /// <summary>
    /// Builds an individual wrapper parameter declaration.
    /// </summary>
    private static string BuildParameterDeclaration(
        SentinelParameterGenerationMetadata parameter)
    {
        var declaration =
            new StringBuilder();

        if (parameter.IsParams)
        {
            declaration.Append("params ");
        }
        else
        {
            declaration.Append(
                parameter.RefKind switch
                {
                    RefKind.Ref => "ref ",
                    RefKind.Out => "out ",
                    RefKind.In => "in ",
                    _ => string.Empty
                });
        }

        declaration.Append(
            parameter.ParameterType);

        declaration.Append(' ');

        declaration.Append(
            parameter.Name);

        return declaration.ToString();
    }

    /// <summary>
    /// Generates the wrapper method body.
    /// </summary>
    private static void GenerateMethodBody(
        StringBuilder source,
        SentinelMethodGenerationMetadata metadata)
    {
        string invocation =
            BuildInvocation(metadata);

        source.AppendLine(
            "        // Sentinel Diagnostics: Method start.");

        source.AppendLine(
            "        // TODO: Emit start logging.");

        source.AppendLine();

        if (metadata.IsAsync)
        {
            GenerateAsyncInvocation(
                source,
                metadata,
                invocation);
        }
        else
        {
            GenerateSynchronousInvocation(
                source,
                metadata,
                invocation);
        }

        source.AppendLine();

        source.AppendLine(
            "        // Sentinel Diagnostics: Method end.");

        source.AppendLine(
            "        // TODO: Emit end logging.");
    }

    /// <summary>
    /// Generates a synchronous method invocation and preserves the
    /// original return value where applicable.
    /// </summary>
    private static void GenerateSynchronousInvocation(
        StringBuilder source,
        SentinelMethodGenerationMetadata metadata,
        string invocation)
    {
        if (metadata.ReturnType == "void")
        {
            source.Append("        ");
            source.Append(invocation);
            source.AppendLine(";");
            return;
        }

        source.Append("        var result = ");
        source.Append(invocation);
        source.AppendLine(";");

        source.AppendLine();

        source.AppendLine(
            "        return result;");
    }

    /// <summary>
    /// Generates an asynchronous invocation using await.
    /// </summary>
    private static void GenerateAsyncInvocation(
        StringBuilder source,
        SentinelMethodGenerationMetadata metadata,
        string invocation)
    {
        source.Append("        ");

        if (metadata.ReturnType == "global::System.Threading.Tasks.Task")
        {
            source.Append("await ");
            source.Append(invocation);
            source.AppendLine(";");
            return;
        }

        source.Append("var result = await ");
        source.Append(invocation);
        source.AppendLine(";");

        source.AppendLine();

        source.AppendLine(
            "        return result;");
    }

    /// <summary>
    /// Builds the invocation expression for the original method.
    ///
    /// Because the generated member resides inside the original
    /// containing type, instance methods are invoked directly rather
    /// than through a generated target object.
    /// </summary>
    private static string BuildInvocation(
        SentinelMethodGenerationMetadata metadata)
    {
        string arguments =
            BuildArgumentList(metadata);

        return
            $"{metadata.MethodName}({arguments})";
    }

    /// <summary>
    /// Builds the argument list for the original method invocation while
    /// preserving ref, out, and in modifiers.
    /// </summary>
    private static string BuildArgumentList(
        SentinelMethodGenerationMetadata metadata)
    {
        var arguments =
            new StringBuilder();

        for (int index = 0;
             index < metadata.Parameters.Length;
             index++)
        {
            if (index > 0)
            {
                arguments.Append(", ");
            }

            SentinelParameterGenerationMetadata parameter =
                metadata.Parameters[index];

            switch (parameter.RefKind)
            {
                case RefKind.Ref:
                    arguments.Append("ref ");
                    break;

                case RefKind.Out:
                    arguments.Append("out ");
                    break;

                case RefKind.In:
                    arguments.Append("in ");
                    break;
            }

            arguments.Append(
                parameter.Name);
        }

        return arguments.ToString();
    }

    /// <summary>
    /// Determines whether the original method and containing type have
    /// accessibility appropriate for generated partial source.
    /// </summary>
    private static bool IsSupportedAccessibility(
        SentinelMethodGenerationMetadata metadata)
    {
        return metadata.MethodAccessibility is
                   Accessibility.Public or
                   Accessibility.Internal or
                   Accessibility.Private or
                   Accessibility.Protected or
                   Accessibility.ProtectedOrInternal or
                   Accessibility.ProtectedAndInternal
               &&
               metadata.DeclaringTypeAccessibility is
                   Accessibility.Public or
                   Accessibility.Internal;
    }

    /// <summary>
    /// Creates a deterministic source hint name for a generated wrapper.
    /// </summary>
    private static string CreateHintName(
        SentinelMethodGenerationMetadata metadata)
    {
        string typeName =
            Sanitize(metadata.FullyQualifiedDeclaringTypeName);

        string methodName =
            Sanitize(metadata.MethodName);

        return
            $"{typeName}.{methodName}.AutoLog.g.cs";
    }

    /// <summary>
    /// Converts a symbol-derived name into a safe source hint name.
    /// </summary>
    private static string Sanitize(
        string value)
    {
        var builder =
            new StringBuilder(value.Length);

        foreach (char character in value)
        {
            if (char.IsLetterOrDigit(character) ||
                character == '_' ||
                character == '.')
            {
                builder.Append(character);
            }
            else
            {
                builder.Append('_');
            }
        }

        return builder.ToString();
    }

    private static bool ValidateContainingTypes(
        SourceProductionContext context,
        SentinelMethodGenerationMetadata metadata)
    {
        foreach (ContainingTypeGenerationMetadata type
                 in metadata.ContainingTypes)
        {
            if (type.IsPartial)
            {
                continue;
            }

            context.ReportDiagnostic(
                Diagnostic.Create(
                    SentinelGeneratorDiagnostics
                        .ContainingTypeMustBePartial,
                    location: metadata.MethodLocation,
                    type.Name,
                    metadata.MethodName));

            return false;
        }

        return true;
    }
}