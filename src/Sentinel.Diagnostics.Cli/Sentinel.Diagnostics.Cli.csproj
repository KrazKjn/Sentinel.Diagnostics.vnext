<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- Required for MSBuild packages targeting .NET Framework -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Prevent MSBuild runtime conflicts -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="sentinel.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn + MSBuildWorkspace -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />

    <!--
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.10.0" />
    -->

    <!-- MSBuildLocator (runtime loader for SDK MSBuild) -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" PrivateAssets="all" />

    <!-- MSBuild compile-time types ONLY (runtime excluded) -->
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />

    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />

    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
    
    <!--<PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>-->

    <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Diagnostics.Core\Sentinel.Diagnostics.Core.csproj" />
    <ProjectReference Include="..\Sentinel.Diagnostics.Generator\Sentinel.Diagnostics.Generator.csproj" />
    <ProjectReference Include="..\Sentinel.Diagnostics.Instrumentation\Sentinel.Diagnostics.Instrumentation.csproj" />
  </ItemGroup>

</Project>